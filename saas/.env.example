# MemOpt SaaS Configuration
# Copy this file to .env and configure values

# Environment (development, staging, production)
ENV=production

# Database
DATABASE_URL=postgresql://memopt:CHANGE_ME_STRONG_PASSWORD@postgres:5432/memopt

# Redis
REDIS_URL=redis://redis:6379/0

# Admin API Key (MUST be changed in production!)
# Generate with: openssl rand -base64 32
ADMIN_API_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING_32_CHARS_MINIMUM

# Rate Limits
RATE_LIMIT_REVENUE_SHARE=60
RATE_LIMIT_ENTERPRISE=10000

# Token Limits
TOKEN_LIMIT_REVENUE_SHARE_PER_MIN=100000
TOKEN_LIMIT_ENTERPRISE_PER_MIN=10000000
TOKEN_LIMIT_REVENUE_SHARE_PER_MONTH=100000000
TOKEN_LIMIT_ENTERPRISE_PER_MONTH=999999999999

# Concurrent Requests
MAX_CONCURRENT_REVENUE_SHARE=5
MAX_CONCURRENT_ENTERPRISE=100

# Billing
PRICE_PER_1K_TOKENS=0.002
ENTERPRISE_FLAT_MONTHLY=66666.67

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# CORS
CORS_ORIGINS=*

# API
API_HOST=0.0.0.0
API_PORT=8000
