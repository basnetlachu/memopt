# memopt Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git — it contains secrets.

# ─── Required ─────────────────────────────────────────────────────────────────
# Your license key (from welcome email at memopt.ai)
MEMOPT_LICENSE_KEY=sk-lic-your-key-here

# Unique name for this server (appears in the dashboard)
# Use something descriptive: prod-h100-01, staging-a100-02, etc.
NODE_NAME=gpu-server-001

# ─── GPU Cost (for ROI reports) ───────────────────────────────────────────────
# Your actual GPU cost per hour in USD.
# Used to calculate $ saved in the dashboard ROI display.
# H100 on-demand: ~$8.00/hr
# A100 80GB on-demand: ~$3.00/hr
# A100 40GB on-demand: ~$2.00/hr
# RTX 4090 on-demand: ~$0.75/hr
# On-prem: amortize your hardware cost over useful life
MEMOPT_GPU_COST_PER_HOUR=8.00

# ─── Optimization Behavior ────────────────────────────────────────────────────
# false = scan and report only (RECOMMENDED for first deployment)
#         memopt will show recommendations without touching anything
# true  = automatically apply optimizations to eligible GPU processes
MEMOPT_AUTO_APPLY=false

# How often to scan GPUs for optimization opportunities (seconds)
MEMOPT_SCAN_INTERVAL=60

# ─── Multi-Node (optional) ────────────────────────────────────────────────────
# If you have a dedicated control plane server (multi-GPU-server setup),
# set its URL here. Leave blank for single-server deployment.
# Example: MEMOPT_CONTROL_PLANE=http://control-plane.internal:8080
MEMOPT_CONTROL_PLANE=

# ─── Security ─────────────────────────────────────────────────────────────────
# API key for dashboard and API access.
# Leave blank on FIRST RUN — memopt generates one and prints it to logs.
# After first run, copy from logs and set here to persist across restarts.
# If running multiple nodes, set the same key on all nodes.
MEMOPT_API_KEY=

# ─── HTTPS / TLS (optional) ───────────────────────────────────────────────────
# Set to true to enable HTTPS via nginx.
# Requires either: a domain name pointing to this server (for auto cert),
#                  or existing certs provided via MEMOPT_TLS_CERT/KEY.
MEMOPT_HTTPS=false

# Your domain name (only needed when MEMOPT_HTTPS=true)
# MEMOPT_DOMAIN=memopt.yourcompany.com

# ─── Keygen.sh (filled in by memopt, do not change) ──────────────────────────
KEYGEN_ACCOUNT_ID=YOUR_KEYGEN_ACCOUNT_ID
