# MemOpt Production Dockerfile
# Multi-stage build for security and smaller image size

# ============================================
# Stage 1: Builder
# ============================================
FROM nvidia/cuda:12.1.0-devel-ubuntu22.04 AS builder

# Install Python and build dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-dev \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only dependency files first (for Docker layer caching)
COPY requirements.txt setup.py ./
COPY memopt/__init__.py memopt/__init__.py

# Install dependencies
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r requirements.txt

# Copy full source code
COPY . .

# Install MemOpt package
RUN pip3 install -e .

# ============================================
# Stage 2: Runtime
# ============================================
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 memopt && \
    mkdir -p /app /models /data && \
    chown -R memopt:memopt /app /models /data

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.10/dist-packages /usr/local/lib/python3.10/dist-packages
COPY --from=builder /build /app

# Set ownership
RUN chown -R memopt:memopt /app

# Switch to non-root user
USER memopt

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    MEMOPT_MODEL_CACHE=/models \
    MEMOPT_LOG_LEVEL=INFO \
    CUDA_VISIBLE_DEVICES=0

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start server
# Default model can be overridden via command or env var
CMD ["python3", "-m", "memopt.api.server", \
     "--model", "gpt2-xl", \
     "--optimization", "high", \
     "--host", "0.0.0.0", \
     "--port", "8000"]