{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "memopt canary rollout monitoring — stage, progress, error rate, certification pass rate, drift.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Rollout Stage",
      "description": "Current rollout stage. -1=no active, 0=pending, 1..4=stages 1-ALL, 5=completed, 6=paused, 7=failed.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "memopt_rollout_stage",
          "legendFormat": "stage",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "No Active Rollout", "color": "green" } } },
            { "type": "value", "options": { "0":  { "text": "Pending",           "color": "text"  } } },
            { "type": "value", "options": { "1":  { "text": "Stage 1 — Canary",  "color": "yellow"} } },
            { "type": "value", "options": { "2":  { "text": "Stage 2 — Shadow",  "color": "orange"} } },
            { "type": "value", "options": { "3":  { "text": "Stage 3 — Prod-lite","color": "blue" } } },
            { "type": "value", "options": { "4":  { "text": "Stage ALL",         "color": "blue"  } } },
            { "type": "value", "options": { "5":  { "text": "Completed",         "color": "green" } } },
            { "type": "value", "options": { "6":  { "text": "PAUSED",            "color": "red"   } } },
            { "type": "value", "options": { "7":  { "text": "FAILED",            "color": "red"   } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 2,
      "title": "Rollout Progress",
      "description": "Nodes updated as a percentage of total nodes in scope for the current rollout.",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(memopt_rollout_nodes_updated / clamp_min(memopt_rollout_nodes_total, 1)) * 100",
          "legendFormat": "% updated",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green",  "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },

    {
      "id": 3,
      "title": "Healthy Nodes",
      "description": "Number of memopt-serving targets reporting up == 1.",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(up{job=\"memopt-serving\"} == 1)",
          "legendFormat": "healthy",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "id": 4,
      "title": "Request Error Rate",
      "description": "Per-node request error rate over the last minute — sourced from memopt_request_errors_total.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(memopt_request_errors_total[1m])",
          "legendFormat": "{{node_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },

    {
      "id": 5,
      "title": "Certification Pass Rate (%)",
      "description": "Passes / (passes + failures). Below 85% is red; below 95% is yellow.",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(sum(memopt_cert_passes_total) / clamp_min(sum(memopt_cert_passes_total) + sum(memopt_cert_failures_total), 1)) * 100",
          "legendFormat": "pass rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "green",  "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },

    {
      "id": 6,
      "title": "HBM Usage",
      "description": "GPU HBM bytes in use across nodes — watches for per-stage HBM regressions during a rollout.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "memopt_vmm_hbm_bytes_used",
          "legendFormat": "{{node_id}} / GPU {{gpu_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }

  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["memopt", "canary", "rollout"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "memopt — Canary Rollout",
  "uid": "memopt-canary",
  "version": 1,
  "weekStart": ""
}
