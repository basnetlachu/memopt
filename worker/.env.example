# MemOpt Worker Configuration
# Copy this file to .env and fill in the values

# REQUIRED: Worker authentication token (min 32 characters)
# Generate with: openssl rand -hex 32
WORKER_TOKEN=your-secure-token-here-min-32-chars

# REQUIRED: Model to load at startup
MODEL_NAME=meta-llama/Llama-2-7b-hf

# OPTIONAL: HuggingFace token for gated models
HF_TOKEN=

# OPTIONAL: Optimization level (1-10, higher = more memory savings)
OPTIMIZATION_LEVEL=7

# OPTIONAL: Worker port
WORKER_PORT=8001
